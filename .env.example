# ==============================================================================
# APPLICATION & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV=development # Application runtime environment: "development" or "production"
PORT=5000 # Port number the Express HTTP server listens on
MAIN_DOMAIN=mustaqim.site # Root domain used for cross-subdomain auth cookies and canonical URLs
CLIENT_SIDE_URL=http://localhost:3000,http://localhost:3001 # Comma-separated client/dashboard origins allowed by CORS

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_URL=mongodb://localhost:27017/nora_life_style # MongoDB connection URI for database operations and seeding

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
BCRYPT_SALT_ROUND=12 # Number of salt rounds for bcrypt password hashing
ACCESS_TOKEN_SECRET=f083fbbe363dfd1c130842b1ca1c06df902edbbb9afe9b1c435345bdf5c93141d9eb1e8bb4ff1e07e9db8b150c67d869e86321bd4180a976952946dc5900d49e # Secret key used to sign and verify JWT access tokens
REFRESH_TOKEN_SECRET=dcadd0f62b3c295ececdbf67b62d8e9a97349f6fa93c29699c3a08e0b4dfd1301f243c6827d6bfa3daa5e13248d8756982082f4aef7b9efdeaa06ca4b7929549 # Secret key used to sign and verify JWT refresh tokens
SESSION_SECRET=e26fd0346a9d07cf9949a8497d0a4c86ce08cc9868436ad0ade7a05ef5d9a85c8e05084b11d9b0c30a3dfc343f25474e81d4f85574788dcaae994bfa4dfa1887 # AES encryption secret for sensitive database fields (courier passwords; falls back to REFRESH_TOKEN_SECRET)

# Token lifespans (cookie maxAge is automatically converted to milliseconds from these values)
ACCESS_TOKEN_EXPIRES=1d # Access token lifetime and cookie maxAge (e.g., 15m, 1h, 1d)
CUSTOMER_REFRESH_TOKEN_EXPIRES=180d # Customer refresh token lifetime and cookie maxAge (e.g., 30d, 180d)
ADMIN_STAFF_REFRESH_TOKEN_EXPIRES=180d # Admin & staff refresh token lifetime and cookie maxAge (e.g., 30d, 180d)

# ==============================================================================
# SESSION & CART LIFECYCLE
# ==============================================================================
CART_ITEM_EXPIRES=30d # Cart expiration time; session cookie maxAge automatically reuses this duration

# ==============================================================================
# FILE UPLOAD & STORAGE (HYBRID: LOCAL OR CLOUDFLARE R2)
# ==============================================================================
UPLOAD_PLATFORM=local # Storage platform for media assets: "local" or "r2"
LOCAL_UPLOAD_FOLDER=uploads/public # Local directory for uploads (relative to project root)
UPLOAD_IMAGE_SIZE=2000000 # Max allowed image file size in bytes (2MB)
UPLOAD_VIDEO_SIZE=20000000 # Max allowed video file size in bytes for warranty claims (20MB)
UPLOAD_IMAGE_MAX_COUNT=10 # Maximum number of image files allowed in a single multi-file upload
UPLOAD_IMAGE_FORMAT=[".jpg", ".jpeg", ".png", ".webp", ".JPG", ".JPEG", ".PNG", ".WEBP"] # JSON array of allowed image file extensions

IMAGE_BASE_PATH=http://localhost:5000/server-api/uploads/public # Public base URL merged before media paths/keys on every query (e.g., http://localhost:5000/server-api/uploads/public for local, or https://pub-xxx.r2.dev for R2)
R2_ACCOUNT_ID=your_cloudflare_account_id # Cloudflare Account ID hosting the R2 storage bucket
R2_ACCESS_KEY_ID=your_r2_access_key # S3-compatible API Access Key ID for Cloudflare R2
R2_SECRET_ACCESS_KEY=your_r2_secret_key # S3-compatible API Secret Access Key for Cloudflare R2
R2_BUCKET_NAME=your_r2_bucket_name # Target Cloudflare R2 bucket name for uploaded assets
R2_PUBLIC_DOMAIN=your_custom_domain_or_r2_dev_url # Public CDN domain or R2 dev URL used to serve uploaded files

# ==============================================================================
# INITIAL SUPER ADMIN CREDENTIALS (SEEDING)
# ==============================================================================
SEED_EMAIL="mustaqimkhanbd@gmail.com" # Email address for initial super admin account created via npm run seed
