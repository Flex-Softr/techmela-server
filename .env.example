SMTP_PORT=587 # SMTP port: 587 for STARTTLS, 465 for SSL
SMTP_SECURE=false # Set to true for SSL (port 465), false for STARTTLS (port 587)
SMTP_USER="" # SMTP username or authenticated sender email address
SMTP_PASS="" # SMTP password or app-specific password

